// The point types of the library.
//
// An explicit point is given by its coordinates. A point of type Lnc lies
// on the segment between the explicit points p and q: it is q for t = 0 and
// p for t = 1.

point Explicit(p: F64x3) = p;

point Lnc(p: F64x3, q: F64x3, t: f64) = q + t*(p - q)
    where 0 <= t, t <= 1;

// A point of type Bpt lies on the triangle with the corners p, q and r. It is
// u p + v q + (1 - u - v) r, with the barycentric coordinates u, v and
// 1 - u - v all at least zero.
point Bpt(p: F64x3, q: F64x3, r: F64x3, u: f64, v: f64) = r + u*(p - r) + v*(q - r)
    where 0 <= u, 0 <= v, u + v <= 1;
